# Copie para .env  ->  cp .env.example .env
# Usado pelo docker compose (env_file). No .NET, "__" equivale a ":" do appsettings.json.
# Com os valores abaixo nada sai para provedores reais: emails caem no Mailpit
# (http://localhost:8025) e SMS/WhatsApp são apenas simulados no log.

# --- RabbitMQ ---
# {pass} é substituído em runtime pelo valor de RabbitMQ__pass (com URL-encode).
# host.docker.internal = broker publicado na porta 5672 da máquina (o compose da
# messaging-api, ou "docker compose --profile broker up" neste repositório).
RabbitMQ__Url=amqp://messaging:{pass}@host.docker.internal:5672
RabbitMQ__pass=messaging123
RabbitMQ__QueueName=messages-queue
RabbitMQ__StatusQueueName=messages-status-queue

# --- Aplicação ---
Application__Name=messaging-worker
DOTNET_ENVIRONMENT=Development
HEALTH_PORT=8080

# --- Email via SMTP ---
# UseForSystems: sistemas (campo "system" da mensagem) que enviam por SMTP,
# separados por vírgula. "*" = todos. Os demais vão pelo Elastic Email.
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__User=
Smtp__Pass=
Smtp__From=noreply@example.com
Smtp__FromName=Messaging Worker
Smtp__UseForSystems=*

# --- Email via Elastic Email (Enabled=false -> envio simulado no log) ---
ElasticEmail__Enabled=false
ElasticEmail__ApiUrl=https://api.elasticemail.com/v2/email/send
ElasticEmail__ApiKey=your-elastic-email-api-key
ElasticEmail__FromEmail=noreply@example.com
ElasticEmail__FromName=Messaging Worker

# --- SMS via Comtele (Enabled=false -> envio simulado no log) ---
Comtele__Enabled=false
Comtele__ApiKey=your-comtele-api-key
Comtele__SenderId=your-sender-id

# --- WhatsApp via Twilio (Enabled=false -> envio simulado no log) ---
Twilio__Enabled=false
Twilio__AccountSid=your-twilio-account-sid
Twilio__AuthToken=your-twilio-auth-token
Twilio__From=whatsapp:+14155238886
