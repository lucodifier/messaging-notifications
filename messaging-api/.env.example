# Copie para .env  ->  cp .env.example .env
# Usado pelo docker compose (env_file). No .NET, "__" equivale a ":" do appsettings.json.

# --- RabbitMQ ---
# {pass} é substituído em runtime pelo valor de RabbitMQ__pass (com URL-encode).
# "rabbitmq" é o nome do serviço no docker-compose.yml deste repositório.
RabbitMQ__Url=amqp://messaging:{pass}@rabbitmq:5672
RabbitMQ__pass=messaging123
RabbitMQ__QueueName=messages-queue
RabbitMQ__StatusQueueName=messages-status-queue

# --- Outbox (SQLite) ---
Outbox__DbPath=data/outbox.db
Outbox__RetryIntervalSeconds=120
Outbox__MaxAttempts=5
Outbox__PendingTimeoutSeconds=600
Outbox__UnknownTimeoutSeconds=3600
Outbox__LockSeconds=300
Outbox__RetryBatchSize=100

# --- Logs ---
ASPNETCORE_ENVIRONMENT=Development
# Opcional: envia os logs também para um Grafana Loki. Sem isto, só console.
# Loki__Url=http://loki:3100
# Loki__Application=messaging-api
